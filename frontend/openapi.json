{
  "components": {
    "schemas": {
      "ApiCallRead": {
        "description": "What the API sent to the provider for one answer, and the usage it returned.",
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "request": {
            "additionalProperties": true,
            "title": "Request",
            "type": "object"
          },
          "usage": {
            "additionalProperties": true,
            "title": "Usage",
            "type": "object"
          }
        },
        "required": [
          "provider",
          "request",
          "usage"
        ],
        "title": "ApiCallRead",
        "type": "object"
      },
      "AttachmentRead": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "media_type"
        ],
        "title": "AttachmentRead",
        "type": "object"
      },
      "ChatSettings": {
        "description": "How the model answers in a chat; None means the API's default.",
        "properties": {
          "max_tokens": {
            "anyOf": [
              {
                "maximum": 128000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "show_thinking": {
            "default": false,
            "title": "Show Thinking",
            "type": "boolean"
          },
          "system_prompt": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "temperature": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          }
        },
        "title": "ChatSettings",
        "type": "object"
      },
      "ConversationBulkAction": {
        "properties": {
          "action": {
            "enum": [
              "archive",
              "unarchive",
              "delete"
            ],
            "title": "Action",
            "type": "string"
          },
          "ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids",
          "action"
        ],
        "title": "ConversationBulkAction",
        "type": "object"
      },
      "ConversationBulkResult": {
        "description": "How many of the given conversations existed and were changed.",
        "properties": {
          "affected": {
            "title": "Affected",
            "type": "integer"
          }
        },
        "required": [
          "affected"
        ],
        "title": "ConversationBulkResult",
        "type": "object"
      },
      "ConversationFork": {
        "description": "Start a new chat with this one's messages up to and including `exchange_id`.",
        "properties": {
          "exchange_id": {
            "title": "Exchange Id",
            "type": "integer"
          }
        },
        "required": [
          "exchange_id"
        ],
        "title": "ConversationFork",
        "type": "object"
      },
      "ConversationRead": {
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "pinned_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pinned At"
          },
          "show_thinking": {
            "title": "Show Thinking",
            "type": "boolean"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "archived_at",
          "pinned_at",
          "created_at",
          "updated_at",
          "system_prompt",
          "temperature",
          "max_tokens",
          "show_thinking"
        ],
        "title": "ConversationRead",
        "type": "object"
      },
      "ConversationUpdate": {
        "description": "Rename, archive, pin or change the settings of a conversation; fields left out stay as\nthey are.",
        "properties": {
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "pinned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pinned"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatSettings"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "ConversationUpdate",
        "type": "object"
      },
      "ExchangeRead": {
        "properties": {
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/AttachmentRead"
            },
            "title": "Attachments",
            "type": "array"
          },
          "cache_read_tokens": {
            "title": "Cache Read Tokens",
            "type": "integer"
          },
          "cache_write_tokens": {
            "title": "Cache Write Tokens",
            "type": "integer"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "first_token_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "stop_reason": {
            "title": "Stop Reason",
            "type": "string"
          },
          "thinking": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thinking"
          },
          "version_group": {
            "title": "Version Group",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "prompt",
          "reply",
          "provider",
          "model",
          "stop_reason",
          "input_tokens",
          "output_tokens",
          "duration_ms",
          "first_token_ms",
          "created_at",
          "thinking",
          "cache_read_tokens",
          "cache_write_tokens",
          "rating",
          "version_group",
          "is_active",
          "attachments"
        ],
        "title": "ExchangeRead",
        "type": "object"
      },
      "ExchangeUpdate": {
        "description": "Rate an answer and/or make this version of the last message the active one.",
        "properties": {
          "active": {
            "anyOf": [
              {
                "const": true,
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "rating": {
            "anyOf": [
              {
                "enum": [
                  -1,
                  0,
                  1
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "title": "ExchangeUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "ImageCreate": {
        "properties": {
          "data": {
            "title": "Data",
            "type": "string"
          },
          "media_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/gif",
              "image/webp"
            ],
            "title": "Media Type",
            "type": "string"
          }
        },
        "required": [
          "media_type",
          "data"
        ],
        "title": "ImageCreate",
        "type": "object"
      },
      "MessageCreate": {
        "properties": {
          "content": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageCreate"
            },
            "maxItems": 4,
            "title": "Images",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "enum": [
                  "claude",
                  "gemini"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "replaces_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replaces Id"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatSettings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "content"
        ],
        "title": "MessageCreate",
        "type": "object"
      },
      "ModelPrice": {
        "description": "USD per million tokens, for cost estimates. `model` matches by prefix the model id the\nprovider reports (the longest match wins).",
        "properties": {
          "cache_read": {
            "title": "Cache Read",
            "type": "number"
          },
          "cache_write": {
            "title": "Cache Write",
            "type": "number"
          },
          "input": {
            "title": "Input",
            "type": "number"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output": {
            "title": "Output",
            "type": "number"
          }
        },
        "required": [
          "model",
          "input",
          "output",
          "cache_read",
          "cache_write"
        ],
        "title": "ModelPrice",
        "type": "object"
      },
      "ModelSettingsRead": {
        "description": "The models a message can be sent to and the settings shared by every request.",
        "properties": {
          "default_provider": {
            "title": "Default Provider",
            "type": "string"
          },
          "max_tokens": {
            "title": "Max Tokens",
            "type": "integer"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/ModelPrice"
            },
            "title": "Prices",
            "type": "array"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderRead"
            },
            "title": "Providers",
            "type": "array"
          },
          "system_prompt": {
            "title": "System Prompt",
            "type": "string"
          }
        },
        "required": [
          "default_provider",
          "providers",
          "max_tokens",
          "system_prompt",
          "prices"
        ],
        "title": "ModelSettingsRead",
        "type": "object"
      },
      "PromptCreate": {
        "properties": {
          "content": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "PromptCreate",
        "type": "object"
      },
      "PromptRead": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "created_at"
        ],
        "title": "PromptRead",
        "type": "object"
      },
      "ProviderRead": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "available",
          "models"
        ],
        "title": "ProviderRead",
        "type": "object"
      },
      "TokenCount": {
        "description": "Input tokens a message would use, with its conversation's context and settings.",
        "properties": {
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          }
        },
        "required": [
          "input_tokens"
        ],
        "title": "TokenCount",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Claude Platform 101 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/attachments/{attachment_id}": {
      "get": {
        "description": "Return an image sent with a message.",
        "operationId": "get_attachment",
        "parameters": [
          {
            "in": "path",
            "name": "attachment_id",
            "required": true,
            "schema": {
              "title": "Attachment Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/*": {}
            },
            "description": "The image"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Attachment",
        "tags": [
          "exchanges"
        ]
      }
    },
    "/api/conversations": {
      "get": {
        "description": "Return the active (or, with `archived=true`, the archived) conversations: pinned ones\nfirst, then most recent activity first. `q` keeps those whose title or messages contain it\n(any case).",
        "operationId": "list_conversations",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Archived",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationRead"
                  },
                  "title": "Response List Conversations",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/bulk": {
      "post": {
        "description": "Archive, bring back or delete several conversations at once; unknown ids are skipped.",
        "operationId": "bulk_update_conversations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationBulkAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationBulkResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bulk Update Conversations",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{conversation_id}": {
      "delete": {
        "description": "Delete a conversation and its messages. This can't be undone.",
        "operationId": "delete_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Conversation",
        "tags": [
          "conversations"
        ]
      },
      "get": {
        "description": "Return one conversation, active or archived.",
        "operationId": "get_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Conversation",
        "tags": [
          "conversations"
        ]
      },
      "patch": {
        "description": "Rename a conversation, archive or pin it (or undo that), or change its settings.",
        "operationId": "update_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Conversation",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{conversation_id}/fork": {
      "post": {
        "description": "Start a new chat with this one's settings and its messages up to and including\n`exchange_id` (the active versions only), to take the conversation another way.",
