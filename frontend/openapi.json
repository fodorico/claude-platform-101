{
  "components": {
    "schemas": {
      "ConversationBulkAction": {
        "properties": {
          "action": {
            "enum": [
              "archive",
              "unarchive",
              "delete"
            ],
            "title": "Action",
            "type": "string"
          },
          "ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids",
          "action"
        ],
        "title": "ConversationBulkAction",
        "type": "object"
      },
      "ConversationBulkResult": {
        "description": "How many of the given conversations existed and were changed.",
        "properties": {
          "affected": {
            "title": "Affected",
            "type": "integer"
          }
        },
        "required": [
          "affected"
        ],
        "title": "ConversationBulkResult",
        "type": "object"
      },
      "ConversationRead": {
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "archived_at",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationRead",
        "type": "object"
      },
      "ConversationUpdate": {
        "description": "Rename and/or archive a conversation; fields left out stay as they are.",
        "properties": {
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "ConversationUpdate",
        "type": "object"
      },
      "ExchangeRead": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "first_token_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "stop_reason": {
            "title": "Stop Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "prompt",
          "reply",
          "provider",
          "model",
          "stop_reason",
          "input_tokens",
          "output_tokens",
          "duration_ms",
          "first_token_ms",
          "created_at"
        ],
        "title": "ExchangeRead",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "MessageCreate": {
        "properties": {
          "content": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "enum": [
                  "claude",
                  "gemini"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "replaces_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replaces Id"
          }
        },
        "required": [
          "content"
        ],
        "title": "MessageCreate",
        "type": "object"
      },
      "ModelSettingsRead": {
        "description": "The models a message can be sent to and the settings shared by every request.",
        "properties": {
          "default_provider": {
            "title": "Default Provider",
            "type": "string"
          },
          "max_tokens": {
            "title": "Max Tokens",
            "type": "integer"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderRead"
            },
            "title": "Providers",
            "type": "array"
          },
          "system_prompt": {
            "title": "System Prompt",
            "type": "string"
          }
        },
        "required": [
          "default_provider",
          "providers",
          "max_tokens",
          "system_prompt"
        ],
        "title": "ModelSettingsRead",
        "type": "object"
      },
      "ProviderRead": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "available",
          "models"
        ],
        "title": "ProviderRead",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Claude Platform 101 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/conversations": {
      "get": {
        "description": "Return the active (or, with `archived=true`, the archived) conversations, most recent\nactivity first. `q` keeps those whose title or messages contain it (any case).",
        "operationId": "list_conversations",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Archived",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationRead"
                  },
                  "title": "Response List Conversations",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Conversations",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/bulk": {
      "post": {
        "description": "Archive, bring back or delete several conversations at once; unknown ids are skipped.",
        "operationId": "bulk_update_conversations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationBulkAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationBulkResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bulk Update Conversations",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{conversation_id}": {
      "delete": {
        "description": "Delete a conversation and its messages. This can't be undone.",
        "operationId": "delete_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Conversation",
        "tags": [
          "conversations"
        ]
      },
      "get": {
        "description": "Return one conversation, active or archived.",
        "operationId": "get_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Conversation",
        "tags": [
          "conversations"
        ]
      },
      "patch": {
        "description": "Rename a conversation, archive it or bring it back.",
        "operationId": "update_conversation",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Conversation",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/conversations/{conversation_id}/messages": {
      "get": {
        "description": "Return a conversation's exchanges, oldest first.",
        "operationId": "list_conversation_messages",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "title": "Conversation Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExchangeRead"
                  },
                  "title": "Response List Conversation Messages",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Conversation Messages",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness and database connectivity check.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/messages": {
      "post": {
        "description": "Send a message to the chosen model, store the exchange and return it. A message\nwithout a conversation starts one, and the model then writes its title.",
        "operationId": "send_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Message",
        "tags": [
          "messages"
        ]
      }
    },
    "/api/messages/stream": {
      "post": {
        "description": "Send a message and stream the answer as it is generated; the exchange is stored at the\nend. Nothing is stored if the answer fails, even after part of it was streamed.",
        "operationId": "stream_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Server-sent events: `delta` (StreamDelta) for each piece of the answer, then `done` (ExchangeRead) once it is stored, then \u2014 for a new conversation \u2014 `title` (StreamTitle); or `error` (StreamError)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Message",
        "tags": [
          "messages"
        ]
      }
    },
    "/api/model-settings": {
      "get": {
        "description": "Return the providers and models a message can be sent to, and the shared settings.",
        "operationId": "get_model_settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSettingsRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Model Settings",
        "tags": [
          "model settings"
        ]
      }
    }
  }
}
